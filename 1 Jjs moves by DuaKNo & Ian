local ovFrame = { w = 0, hitPose = nil, hw = 0 }
ovApply = function()
	local w, hitPose, hw = ovFrame.w, ovFrame.hitPose, ovFrame.hw
	if w <= 0.001 then return end
	local blockPose = ANIMS.Block and ANIMS.Block.frames[1].j
	for name, m in pairs(ovMotors) do
		local bcf = blockPose and blockPose[name]
		local hcf = hitPose and hitPose[name]
		local tcf, wt
		if hcf then
			if bcf then
				tcf, wt = bcf:Lerp(hcf, hw), w
			else
				tcf, wt = hcf, w * hw
			end
		elseif bcf then
			tcf, wt = bcf, w
		end
		if tcf and wt > 0.001 then
			local ok, cur = pcall(function() return m.Transform end)
			if ok then pcall(function() m.Transform = cur:Lerp(tcf, wt) end) end
		end
	end
end

track(RunService.Heartbeat:Connect(function() ovApply() end))
track(RunService.Stepped:Connect(function() ovApply() end))

pcall(function() RunService:UnbindFromRenderStep("YujiOverlay") end)
RunService:BindToRenderStep("YujiOverlay", Enum.RenderPriority.Last.Value, function(dt)
	local char, hum, root = getRig()
	if not char then
		overlay.w = 0
		ovHitAnim = nil
		speedState.base, speedState.applied = nil, nil
		ovFrame.w = 0
		return
	end
	if char ~= ovChar then
		ovChar = char
		ovMotors = {}
		local want = { ["Right Shoulder"] = true, ["Left Shoulder"] = true, ["Neck"] = true, ["RootJoint"] = true }
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("Motor6D") and want[d.Name] and d.Part1 and not ovMotors[d.Name] then
				ovMotors[d.Name] = d
			end
		end
		ovLastHp = hum.Health
	end
	do
		local mult = (overlay.blocking and CONFIG.BlockSpeedMult or 1) * (speedState.backWalk and CONFIG.BackwardSpeedMult or 1)
		local cur = hum.WalkSpeed
		if speedState.applied and math.abs(cur - speedState.applied) > 0.01 then
			speedState.base = cur
			speedState.applied = nil
		end
		if mult ~= 1 then
			if not speedState.base then speedState.base = cur end
			local target = speedState.base * mult
			if math.abs(cur - target) > 0.01 then hum.WalkSpeed = target end
			speedState.applied = target
		else
			if speedState.applied and speedState.base then hum.WalkSpeed = speedState.base end
			speedState.applied = nil
			speedState.base = nil
		end
	end
	if overlay.blocking then boostFor(1) end
	if overlay.blocking and ovLastHp and hum.Health < ovLastHp - 0.01 then
		triggerBlockHit(root)
	end
	ovLastHp = hum.Health

	local hitPose, hw = nil, 0
	if ovHitAnim then
		ovHitT += dt
		if ovHitT >= ovHitAnim.total or not overlay.blocking then
			ovHitAnim = nil
		else
			hitPose = samplePose(ovHitAnim, ovHitT)
			hw = math.min(ovHitT / 0.04, 1) * math.clamp((ovHitAnim.total - ovHitT) / 0.1, 0, 1)
		end
	end

	if overlay.blocking then
		overlay.w = math.min(1, overlay.w + dt / 0.12)
	else
		overlay.w = math.max(0, overlay.w - dt / 0.15)
	end
	ovFrame.w, ovFrame.hitPose, ovFrame.hw = overlay.w, hitPose, hw
	ovApply()
end)

local npcAnimToken = setmetatable({}, { __mode = "k" })
local npcAnimator = setmetatable({}, { __mode = "k" })

local function sampleAnim(anim, t, motors)
	local frames, times = anim.frames, anim.times
	local i = 1
	while i < #frames and t >= times[i + 1] do i += 1 end
	if i >= #frames then
		for jointName, cf in pairs(frames[#frames].j) do
			local m = motors[jointName]
			if m then m.Transform = cf end
		end
		return true
	end
	local a, b = frames[i], frames[i + 1]
	local alpha = math.clamp((t - times[i]) / math.max(times[i + 1] - times[i], 1e-6), 0, 1)
	for jointName, cfA in pairs(a.j) do
		local m = motors[jointName]
		if m then
			local cfB = b.j[jointName]
			m.Transform = cfB and cfA:Lerp(cfB, alpha) or cfA
		end
	end
	return false
end

local function playNpcAnim(model, name, onDone)
	local anim = ANIMS[name]
	local motors, found = {}, false
	if anim then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Motor6D") and anim.joints[d.Name] and d.Part1 and not motors[d.Name] then
				motors[d.Name] = d
				found = true
			end
		end
	end
	if not found then
		if onDone then onDone() end
		return
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum and not npcAnimator[model] then
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			npcAnimator[model] = animator
			animator.Parent = nil
		end
	end
	local token = (npcAnimToken[model] or 0) + 1
	npcAnimToken[model] = token
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		if npcAnimToken[model] ~= token or not model.Parent then
			conn:Disconnect()
			return
		end
		if sampleAnim(anim, os.clock() - t0, motors) then
			conn:Disconnect()
			for _, m in pairs(motors) do pcall(function() m.Transform = CFrame.new() end) end
			local animator = npcAnimator[model]
			if animator and hum and hum.Parent then animator.Parent = hum end
			npcAnimator[model] = nil
			if onDone then onDone() end
		end
	end)
end

-- ragdoll: troca os Motor6D por BallSocketConstraint (as partes soltam; com o ownership a fisica replica)
local ragdolled = setmetatable({}, { __mode = "k" })

local function ragdollNpc(model, hum, mroot, push, permanent)
	if ragdolled[model] then return end
	ragdolled[model] = true
	playSoundAt(mroot, RAGDOLL_SFX[math.random(#RAGDOLL_SFX)])
	local look = mroot.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	local made = {}
	for _, m in ipairs(model:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 and m.Name ~= "RootJoint" and m.Name ~= "Root" then
			local a0 = Instance.new("Attachment")
			a0.CFrame = m.C0
			a0.Parent = m.Part0
			local a1 = Instance.new("Attachment")
			a1.CFrame = m.C1
			a1.Parent = m.Part1
			local b = Instance.new("BallSocketConstraint")
			b.Attachment0 = a0
			b.Attachment1 = a1
			b.LimitsEnabled = true
			b.UpperAngle = (m.Name == "Neck") and 40 or 80
			b.TwistLimitsEnabled = true
			b.TwistLowerAngle = -35
			b.TwistUpperAngle = 35
			b.Parent = m.Part0
			m.Enabled = false
			made[#made + 1] = { m, a0, a1, b }
		end
	end
	if not permanent then
		pcall(function() hum.PlatformStand = true end)
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
	end
	pcall(function() mroot.AssemblyLinearVelocity = push end)
	if permanent then return end
	task.delay(CONFIG.RagdollTime, function()
		if not model.Parent then return end
		for _, e in ipairs(made) do
			pcall(function() e[1].Enabled = true end)
			for i = 2, 4 do pcall(function() e[i]:Destroy() end) end
		end
		if flatLook.Magnitude > 0.05 then
			local pos = mroot.Position + Vector3.new(0, 2, 0)
			pcall(function() mroot.CFrame = CFrame.lookAt(pos, pos + flatLook.Unit) end)
		end
		pcall(function() hum.PlatformStand = false end)
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		ragdolled[model] = nil
	end)
end

local function groundColor(r)
	local inst = r.Instance
	if inst and inst:IsA("Terrain") then
		local ok, c = pcall(function() return inst:GetMaterialColor(r.Material) end)
		return (ok and c) or Color3.fromRGB(125, 115, 100), Enum.Material.Pebble
	elseif inst and inst:IsA("BasePart") then
		return inst.Color, inst.Material
	end
	return Color3.fromRGB(125, 115, 100), Enum.Material.Pebble
end

local function groundBurst(r, scale)
	scale = scale or 1
	kickCamera(1.5 * scale)
	local n = math.floor((CONFIG.Pebbles or 0) * scale + 0.5)
	if n <= 0 then return end
	local TweenService = game:GetService("TweenService")
	local rng = Random.new()
	local col, mat = groundColor(r)
	for _ = 1, n do
		local s = rng:NextNumber(0.2, 0.55)
		local p = Instance.new("Part")
		p.Size = Vector3.new(s, s * rng:NextNumber(0.6, 1), s * rng:NextNumber(0.7, 1.1))
		p.Color = col:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.18))
		p.Material = mat
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanQuery = false
		p.CanTouch = false
		p.CFrame = CFrame.new(r.Position + Vector3.new(rng:NextNumber(-0.8, 0.8), 0.4, rng:NextNumber(-0.8, 0.8)))
			* CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6))
		p.Parent = workspace
		local a = rng:NextNumber(0, math.pi * 2)
		local sp = rng:NextNumber(12, 30)
		p.AssemblyLinearVelocity = Vector3.new(math.cos(a) * sp, rng:NextNumber(18, 38), math.sin(a) * sp)
		p.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-12, 12), rng:NextNumber(-12, 12), rng:NextNumber(-12, 12))
		Debris:AddItem(p, 1.8)
		task.delay(1.2, function()
			if p.Parent then
				pcall(function() TweenService:Create(p, TweenInfo.new(0.5), { Transparency = 1 }):Play() end)
			end
		end)
	end
end

local function slamNpc(model, hum, mroot, push, dead)
	ragdollNpc(model, hum, mroot, Vector3.new(push.X * 4, 24, push.Z * 4), dead)
	task.delay(0.14, function()
		if not mroot.Parent then return end
		if CONFIG.OwnershipTrick then boostSimulation() end
		pcall(function()
			mroot.AssemblyLinearVelocity = Vector3.new(push.X * 4, -CONFIG.SlamSpeed, push.Z * 4)
		end)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { model, lp.Character }
		local t0 = os.clock()
		while os.clock() - t0 < 0.8 do
			RunService.Heartbeat:Wait()
			if not mroot.Parent then return end
			local r = workspace:Raycast(mroot.Position, Vector3.new(0, -6, 0), params)
			if r and mroot.Position.Y - r.Position.Y < 3.4 then
				groundBurst(r)
				return
			end
		end
	end)
end

local function damageNpc(model, hum, mroot, root, dmg, kind, punchIdx)
	if CONFIG.OwnershipTrick then
		ownershipUntil = os.clock() + 4
		boostSimulation()
	end
	local hp = (virtualHp[hum] or hum.Health) - dmg
	virtualHp[hum] = hp
	local dead = hp <= 0
	local push = mroot.Position - root.Position
	push = Vector3.new(push.X, 0, push.Z)
	push = push.Magnitude > 0.01 and push.Unit or root.CFrame.LookVector

	if kind == "AirM1" or punchIdx == 4 then
		playSoundAt(mroot, HIT_SFX.Hit4)
	elseif punchIdx then
		playSoundAt(mroot, HIT_SFX.Hit3)
	end

	local function doRagdoll()
		ragdollNpc(model, hum, mroot,
			push * CONFIG.Knockback * 1.2 + Vector3.new(0, CONFIG.Knockback * 0.5, 0), dead)
	end
	if punchIdx then
		playNpcAnim(model, "NpcHit" .. punchIdx, (punchIdx == 4) and doRagdoll or nil)
	end
	if kind == "AirM1" then slamNpc(model, hum, mroot, push, dead) end
	if kind ~= "AirM1" and kind ~= "BlackFlash" then
		task.delay(0.1, function()
			if not mroot.Parent then return end
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { model, lp.Character }
			local r = workspace:Raycast(mroot.Position, Vector3.new(0, -8, 0), params)
			if r then groundBurst(r, (punchIdx == 4) and 0.7 or 0.45) end
		end)
	end
	kickCamera(kind == "AirM1" and 0.8 or kind == "BlackFlash" and 1.2 or (punchIdx == 4 and 0.8 or 0.4))

	task.spawn(function()
		local t0 = os.clock()
		while CONFIG.OwnershipTrick and not ownsPart(mroot) and os.clock() - t0 < 0.5 do
			boostSimulation()
			task.wait()
		end
		if kind ~= "AirM1" then
			pcall(function()
				mroot.AssemblyLinearVelocity = push * CONFIG.Knockback + Vector3.new(0, CONFIG.Knockback * 0.35, 0)
			end)
		end
		pcall(function() hum.Health = math.max(hp, 0) end)
		if dead then
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
			pcall(function() hum.Health = 0 end)
		end
	end)
end

local function pushLooseParts(root, range, cone, flatLook)
	if not CONFIG.KnockUnanchored then return end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { lp.Character }
	local seen = {}
	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, range, params)) do
		if not part.Anchored then
			local model = part:FindFirstAncestorOfClass("Model")
			local isChar = model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
			local asm = part.AssemblyRootPart
			if not isChar and asm and not asm.Anchored and not seen[asm] then
				local to = asm.Position - root.Position
				local flat = Vector3.new(to.X, 0, to.Z)
				if flat.Magnitude < 0.01 or flat.Unit:Dot(flatLook) >= cone then
					seen[asm] = true
					local dir = (to.Magnitude > 0.01) and to.Unit or root.CFrame.LookVector
					pcall(function()
						asm.AssemblyLinearVelocity = dir * CONFIG.Knockback + Vector3.new(0, CONFIG.Knockback * 0.4, 0)
					end)
				end
			end
		end
	end
end

local function hitNpcs(root, kind, animName)
	local dmg = CONFIG.DamageValues[kind] or 10
	local punchIdx = tonumber(string.match(animName or "", "^Punch(%d)$"))
	local range = (kind == "BlackFlash") and CONFIG.BlackFlashRange or (kind == "DashM1" and CONFIG.DashHitRange or CONFIG.HitRange)
	local cone = (kind == "DashM1") and CONFIG.DashHitCone or CONFIG.HitCone
	local look = root.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.01 then return end
	flatLook = flatLook.Unit
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { lp.Character }
	local seen = {}
	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, range, params)) do
		local model = part:FindFirstAncestorOfClass("Model")
		local hum = model and model:FindFirstChildOfClass("Humanoid")
		if hum and not seen[hum] and hum.Health > 0 and not Players:GetPlayerFromCharacter(model) then
			local mroot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or part
			local to = mroot.Position - root.Position
			local flat = Vector3.new(to.X, 0, to.Z)
			if flat.Magnitude < 0.01 or flat.Unit:Dot(flatLook) >= cone then
				seen[hum] = true
				damageNpc(model, hum, mroot, root, dmg, kind, punchIdx)
			end
		end
	end
	pushLooseParts(root, range, cone, flatLook)
end

function scheduleHit(cur, root)
	local def = HIT_DEF[cur.name]
	if not def or not CONFIG.Damage then return end
	task.delay(def.t / (cur.anim.speed or 1), function()
		if current ~= cur or not root.Parent then return end
		hitNpcs(root, cur.hitKind or def.kind, cur.name)
	end)
end

local function punch()
	local now = os.clock()
	local dashing = current ~= nil and DASH_ANIMS[current.name] == true
	if (actionBusy() and not dashing) or now < state.punchLockedUntil then return end
	overlay.blocking = false
	boostFor(3)
	if dashing then stopDash() end
	if now - state.lastPunchEnd > CONFIG.ComboWindow then
		state.combo = 1
	end
	local idx = state.combo
	local animName = "Punch" .. idx
	local _, hum = getRig()
	local inAir = hum ~= nil and (airborne or hum.FloorMaterial == Enum.Material.Air)
	if idx == 3 and inAir and ANIMS.AirSkill then
		animName = "AirSkill"
	end
	local started = play(animName, function()
		state.lastPunchEnd = os.clock()
		if idx >= 4 then
			state.combo = 1
			state.punchLockedUntil = state.lastPunchEnd + CONFIG.ComboEndCooldown
		end
		refreshAir()
	end, "action")
	if started then
		state.combo = (idx % 4) + 1
		if dashing and current then
			current.hitKind = "DashM1"
			local _, _, r = getRig()
			if r then
				local lk = r.CFrame.LookVector
				r.AssemblyLinearVelocity = Vector3.new(lk.X * 40, r.AssemblyLinearVelocity.Y, lk.Z * 40)
			end
		end
	end
end

local function blackFlash()
	local now = os.clock()
	if now < state.flashLockedUntil then return end
	local _, hum = getRig()
	if not hum then return end
	state.flashLockedUntil = now + CONFIG.BlackFlashCooldown
	overlay.blocking = false
	boostFor(4)
	stopVault()
	state.combo = 1
	stopDash()
	play("BlackFlash", function()
		refreshAir()
	end, "action")
end

local function dash()
	local now = os.clock()
	if now < state.dashLockedUntil then return end
	local _, hum, root = getRig()
	if not root then return end
	state.dashLockedUntil = now + CONFIG.DashCooldown
	overlay.blocking = false
	boostFor(3)
	stopVault()
	state.combo = 1
	local animName, dirVec, faceVec = "Dash", nil, nil
	local cam = workspace.CurrentCamera
	local md = hum and hum.MoveDirection or Vector3.zero
	if cam and md.Magnitude > 0.1 then
		local cl = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		local cr = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
		if cl.Magnitude > 0.01 and cr.Magnitude > 0.01 then
			cl, cr = cl.Unit, cr.Unit
			local m = md.Unit
			local r, f = m:Dot(cr), m:Dot(cl)
			if math.abs(r) > 0.4 and math.abs(r) > math.abs(f) then
				animName = (r > 0) and "DashRight" or "DashLeft"
				if not ANIMS[animName] then animName = "Dash" end
				if animName ~= "Dash" then
					dirVec = cr * (r > 0 and 1 or -1)
					faceVec = cl
				end
			elseif f < -0.4 and ANIMS.DashBack then
				animName = "DashBack"
				dirVec = -cl
				faceVec = cl
			end
		end
	end
	play(animName, function()
		stopDash()
		refreshAir()
	end, "action")
	startDash(root, dirVec, faceVec)
end

local S = Enum.HumanoidStateType
local LAND_STATES = { [S.Landed] = true, [S.Running] = true, [S.RunningNoPhysics] = true }
local BREAK_STATES = {
	[S.Swimming] = true, [S.Climbing] = true, [S.Seated] = true, [S.PlatformStanding] = true,
	[S.Ragdoll] = true, [S.FallingDown] = true, [S.GettingUp] = true, [S.Flying] = true,
	[S.Dead] = true,
}

local function onStateChanged(_, new)
	if new == S.Jumping then
		airborne = true
		if not actionBusy() then
			play("Jump", function()
				if airborne then play("Fall", nil, "air") end
			end, "air")
		end
	elseif new == S.Freefall then
		airborne = true
		if actionBusy() then return end
		if current and (current.name == "Jump" or current.name == "Fall") then return end
		play("Fall", nil, "air")
	elseif LAND_STATES[new] then
		if not airborne then return end
		airborne = false
		if actionBusy() then return end
		if not play("Land", nil, "air") and current and current.layer == "air" then
			endCurrent(false)
		end
	elseif BREAK_STATES[new] then
		airborne = false
		if current and current.layer == "air" then
			endCurrent(false)
		end
	end
end

local function bindCharacter(char)
	if stateConn then
		stateConn:Disconnect()
		stateConn = nil
	end
	airborne = false
	task.spawn(function()
		local hum = char:WaitForChild("Humanoid", 10)
		if not hum or lp.Character ~= char then return end
		stateConn = hum.StateChanged:Connect(onStateChanged)
		local st = hum:GetState()
		if st == S.Freefall or st == S.Jumping then
			airborne = true
		end
	end)
end

local vaultParams = RaycastParams.new()
vaultParams.FilterType = Enum.RaycastFilterType.Exclude
vaultParams.RespectCanCollide = true

local function isCharacterPart(inst)
	local model = inst:FindFirstAncestorOfClass("Model")
	return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function startVaultMove(root, cur, p0, p1, peakY, duration, forward)
	state.vaultToken += 1
	local token = state.vaultToken
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		if state.vaultToken ~= token or current ~= cur or not root.Parent then
			conn:Disconnect()
			return
		end
		local a = math.clamp((os.clock() - t0) / duration, 0, 1)
		local pos = p0:Lerp(p1, a)
		local lift = math.max(0, peakY - math.max(p0.Y, p1.Y)) * math.sin(math.pi * a)
		pos = Vector3.new(pos.X, pos.Y + lift, pos.Z)
		root.CFrame = CFrame.lookAt(pos, pos + forward)
		root.AssemblyLinearVelocity = Vector3.zero
		if a >= 1 then conn:Disconnect() end
	end)
end

local function tryVault(char, hum, root, inAir)
	local now = os.clock()
	if now < state.vaultLockedUntil then return false end
	local dir = hum.MoveDirection
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 0.1 then return false end
	flat = flat.Unit
	vaultParams.FilterDescendantsInstances = { char }

	local pos = root.Position
	local feetY, rootHeight
	if inAir then
		feetY = pos.Y - 3
		rootHeight = 3
	else
		local ground = workspace:Raycast(pos, Vector3.new(0, -8, 0), vaultParams)
		if not ground then return false end
		feetY = ground.Position.Y
		rootHeight = pos.Y - feetY
	end
	local maxH = inAir and CONFIG.VaultAirMaxHeight or CONFIG.VaultMaxHeight
	local minH = inAir and 0.5 or CONFIG.VaultMinHeight
	local reach = CONFIG.VaultReach

	local low = workspace:Raycast(Vector3.new(pos.X, feetY + 0.8, pos.Z), flat * reach, vaultParams)
	if not low or isCharacterPart(low.Instance) then return false end
	if math.abs(low.Normal.Y) > 0.35 then return false end
	if flat:Dot(-low.Normal) < 0.5 then return false end

	local high = workspace:Raycast(
		Vector3.new(pos.X, feetY + maxH + 0.2, pos.Z), flat * reach, vaultParams)
	if high then return false end

	local into = low.Position - low.Normal * 0.3
	local topRay = workspace:Raycast(
		Vector3.new(into.X, feetY + maxH + 0.5, into.Z),
		Vector3.new(0, -(maxH + 0.5), 0), vaultParams)
	if not topRay or topRay.Normal.Y < 0.7 then return false end
	local topY = topRay.Position.Y
	local h = topY - feetY
	if h < minH or h > maxH then return false end

	if workspace:Raycast(topRay.Position + Vector3.new(0, 0.1, 0),
		Vector3.new(0, rootHeight + 1.5, 0), vaultParams) then
		return false
	end

	local topPoint = Vector3.new(into.X, topY, into.Z)
	local p1
	local far = workspace:Raycast(
		topPoint + flat * CONFIG.VaultMaxDepth - Vector3.new(0, 0.4, 0),
		-flat * CONFIG.VaultMaxDepth, vaultParams)
	if far then
		local land = far.Position + flat * 1.6
		local floor = workspace:Raycast(Vector3.new(land.X, topY + 2, land.Z), Vector3.new(0, -30, 0), vaultParams)
		if floor and floor.Position.Y <= topY then
			p1 = floor.Position + Vector3.new(0, rootHeight, 0)
		end
	end
	if not p1 then
		local up = topPoint + flat * 1.0
		p1 = Vector3.new(up.X, topY + rootHeight, up.Z)
	end
	local peakY = topY + rootHeight + 0.5

	local idx = state.vaultIndex
	local name = "Parkour" .. idx
	local anim = ANIMS[name]
	if not anim then return false end
	if not play(name, function() refreshAir() end, "action") then return false end
	state.vaultIndex = (idx % 4) + 1
	state.combo = 1
	local duration = anim.total / (anim.speed or 1)
	state.vaultLockedUntil = now + duration + CONFIG.VaultCooldown
	startVaultMove(root, current, pos, p1, peakY, duration, flat)
	return true
end

local strafeActive, strafePrev = false, nil
local function endStrafe()
	if not strafeActive then return end
	strafeActive = false
	local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	if h and strafePrev ~= nil then pcall(function() h.AutoRotate = strafePrev end) end
	strafePrev = nil
end

-- andar/correr: ate 25% da velocidade maxima = Walk, de 26% a 100% = Run
track(RunService.Heartbeat:Connect(function()
	if not CONFIG.RunAnim then return end
	local char, hum, root = getRig()
	if not char then
		speedState.backWalk = false
		endStrafe()
		return
	end
	local inAir = airborne or hum.FloorMaterial == Enum.Material.Air
	local input = hum.MoveDirection.Magnitude > 0.1 and hum.Sit == false
	local pushing = input and not inAir
	if CONFIG.Vault and input and not overlay.blocking and (not inAir or CONFIG.VaultAir) and not actionBusy()
		and tryVault(char, hum, root, inAir) then
		return
	end
	local vel = root.AssemblyLinearVelocity
	local flatSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local ratio = flatSpeed / math.max(speedState.base or hum.WalkSpeed, 1)
	local backNow = false
	local moving = pushing and flatSpeed > 0.5
	if moving then
		local runNow = current ~= nil and current.name == "Run"
		local want = (ratio > CONFIG.WalkMaxRatio + (runNow and -0.03 or 0.01)) and "Run" or "Walk" -- histerese
		if not ANIMS[want] then want = "Run" end
		if overlay.blocking and ANIMS.Walk then want = "Walk" end
		do
			local lk = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
			if lk.Magnitude > 0.01 and hum.MoveDirection.Magnitude > 0.1 and hum.MoveDirection.Unit:Dot(lk.Unit) < -0.35 then
				backNow = true
				if ANIMS.Walk then want = "Walk" end
			end
		end
		local cam = workspace.CurrentCamera
		if cam and ANIMS.WalkRight and ANIMS.WalkLeft then
			local cl = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
			local cr = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
			if cl.Magnitude > 0.01 and cr.Magnitude > 0.01 then
				local m = hum.MoveDirection.Unit
				local r, f = m:Dot(cr.Unit), m:Dot(cl.Unit)
				local was = current ~= nil and (current.name == "WalkRight" or current.name == "WalkLeft")
				if math.abs(r) > (was and 0.55 or 0.72) and math.abs(r) > math.abs(f) * (was and 0.8 or 1) and f > (was and -0.45 or -0.3) then
					want = (r > 0) and "WalkRight" or "WalkLeft"
				end
			end
		end
		if not current then
			play(want, nil, "move")
		elseif current.layer == "move" and current.name ~= want then
			play(want, nil, "move")
		end
	elseif current and current.layer == "move" and not (current.name == "Block" and overlay.blocking) then
		endCurrent(false)
	end
	speedState.backWalk = backNow
	if not moving and overlay.blocking and not current and ANIMS.Block and hum.Sit == false then
		play("Block", nil, "move")
	end
	local strafeOn = moving and current ~= nil and (current.name == "WalkRight" or current.name == "WalkLeft")
		and ((not CONFIG.StrafeWalkOnly) or ratio <= CONFIG.WalkMaxRatio + 0.12)
	if strafeOn then
		local cam = workspace.CurrentCamera
		if not strafeActive then
			strafeActive = true
			strafePrev = hum.AutoRotate
			hum.AutoRotate = false
		end
		if cam then
			local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
			if look.Magnitude > 0.01 then
				root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, root.Position + look.Unit), 0.35)
			end
		end
	else
		endStrafe()
	end
end))

local ACTION_M1, ACTION_DASH, ACTION_STOP, ACTION_BLOCK, ACTION_FLASH = "YujiM1", "YujiDash", "YujiCancel", "YujiBlock", "YujiBlackFlash"

local function onM1(_, inputState)
	if inputState == Enum.UserInputState.Begin then punch() end
	return Enum.ContextActionResult.Pass
end
local function onDash(_, inputState)
	if inputState == Enum.UserInputState.Begin then dash() end
	return Enum.ContextActionResult.Pass
end
local function onFlash(_, inputState)
	if inputState == Enum.UserInputState.Begin then blackFlash() end
	return Enum.ContextActionResult.Pass
end
local function onStop(_, inputState)
	if inputState == Enum.UserInputState.Begin then cancelAll() end
	return Enum.ContextActionResult.Pass
end

local function toggleBlock()
	overlay.blocking = not overlay.blocking
end

local function onBlock(_, inputState)
	if inputState == Enum.UserInputState.Begin then toggleBlock() end
	return Enum.ContextActionResult.Pass
end

local function setupButton(action, title)
	ContextActionService:SetTitle(action, title)
end

local controlsOn = false
local flashTool = nil
local flashRetryAt = 0
local function destroyFlashTool()
	if flashTool then
		pcall(function() flashTool:Destroy() end)
		flashTool = nil
	end
end
local function makeFlashTool()
	destroyFlashTool()
	local tool = Instance.new("Tool")
	tool.Name = "Black Flash"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Black Flash (cooldown " .. CONFIG.BlackFlashCooldown .. "s)"
	tool.Activated:Connect(function() blackFlash() end)
	flashTool = tool
	task.spawn(function()
		local bp = lp:WaitForChild("Backpack", 10)
		if bp and flashTool == tool then tool.Parent = bp end
	end)
end
track(RunService.Heartbeat:Connect(function()
	if flashTool and flashTool.Parent then
		local rem = state.flashLockedUntil - os.clock()
		local want = (rem > 0) and string.format("%.1fs", rem) or "Black Flash"
		if flashTool.Name ~= want then flashTool.Name = want end
	elseif controlsOn and flashTool and os.clock() > flashRetryAt then
		flashRetryAt = os.clock() + 1
		makeFlashTool()
	end
end))

local function layoutButtons()
	local btns = {}
	for _, a in ipairs({ ACTION_M1, ACTION_DASH, ACTION_BLOCK }) do
		local b = ContextActionService:GetButton(a)
		if not b then return end
		btns[#btns + 1] = b
	end
	local sg = btns[1]:FindFirstAncestorOfClass("ScreenGui")
	local parent = btns[1].Parent
	if not sg or not parent then return end
	local size = CONFIG.ButtonSize
	local sgPos, sgSize = sg.AbsolutePosition, sg.AbsoluteSize
	local jx, jy, jw, jh
	local pg = lp:FindFirstChildOfClass("PlayerGui")
	local tg = pg and pg:FindFirstChild("TouchGui")
	local jump = tg and tg:FindFirstChild("JumpButton", true)
	if jump and jump:IsA("GuiObject") and jump.AbsoluteSize.X > 0 then
		jx, jy = jump.AbsolutePosition.X, jump.AbsolutePosition.Y
		jw, jh = jump.AbsoluteSize.X, jump.AbsoluteSize.Y
	else
		jw, jh = 110, 110
		jx = sgPos.X + sgSize.X - 25 - jw
		jy = sgPos.Y + sgSize.Y - 25 - jh
	end
	local right = jx - CONFIG.ButtonJumpGap
	local bottom = jy + jh
	local gap = 16
	local spots = {
		{ right, bottom },
		{ right - size - gap, bottom },
		{ right, bottom - size - gap },
	}
	local pAbs = parent.AbsolutePosition
	for i, b in ipairs(btns) do
		local x = math.max(spots[i][1], sgPos.X + size + 8)
		local y = math.max(spots[i][2], sgPos.Y + size + 8)
		b.AnchorPoint = Vector2.new(1, 1)
		b.Size = UDim2.fromOffset(size, size)
		b.Position = UDim2.fromOffset(x - pAbs.X, y - pAbs.Y)
	end
end

