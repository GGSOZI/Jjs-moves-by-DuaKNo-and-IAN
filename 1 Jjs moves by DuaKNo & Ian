local rad = math.rad
-- fwd = graus pra frente (negativo = pra tras), out = graus pra fora
local function RS(fwd, out) return CFrame.Angles(0, 0, rad(fwd or 0)) * CFrame.Angles(rad(-(out or 0)), 0, 0) end
local function LS(fwd, out) return CFrame.Angles(0, 0, rad(-(fwd or 0))) * CFrame.Angles(rad(-(out or 0)), 0, 0) end
local function RH(fwd, out) return CFrame.Angles(0, 0, rad(fwd or 0)) * CFrame.Angles(rad(-(out or 0)), 0, 0) end
local function LH(fwd, out) return CFrame.Angles(0, 0, rad(-(fwd or 0))) * CFrame.Angles(rad(-(out or 0)), 0, 0) end
-- lean = inclina pra frente, yaw = gira, down = abaixa o corpo (studs)
local function TORSO(lean, yaw, down) return CFrame.new(0, 0, -(down or 0)) * CFrame.Angles(rad(lean or 0), 0, rad(yaw or 0)) end
-- tilt positivo = olha pra baixo
local function HEAD(tilt, yaw) return CFrame.Angles(rad(tilt or 0), 0, rad(yaw or 0)) end
local function F(dt, rs, ls, rh, lh, root, neck)
	return { dt = dt, j = {
		["Right Shoulder"] = rs, ["Left Shoulder"] = ls,
		["Right Hip"] = rh, ["Left Hip"] = lh,
		["RootJoint"] = root, ["Neck"] = neck,
	} }
end

