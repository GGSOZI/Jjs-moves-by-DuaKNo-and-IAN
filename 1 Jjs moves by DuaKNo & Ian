do
	local camOff = Vector3.zero
	local camRng = Random.new()
	pcall(function() RunService:UnbindFromRenderStep("YujiCamFollow") end)
	if CONFIG.CameraFollow then
		RunService:BindToRenderStep("YujiCamFollow", Enum.RenderPriority.Camera.Value - 1, function(dt)
			local char, hum, root = getRig()
			if not char then return end
			local head = char:FindFirstChild("Head")
			if not head then return end
			local delta = head.Position - (root.Position + Vector3.new(0, 1.5, 0))
			local off = root.CFrame:VectorToObjectSpace(delta) * CONFIG.CameraFollowStrength
			if off.Magnitude > 2.5 then off = off.Unit * 2.5 end
			local vel = root.AssemblyLinearVelocity
			local ratio = math.clamp(Vector3.new(vel.X, 0, vel.Z).Magnitude / math.max(hum.WalkSpeed, 1), 0, 1.5)
			if hum.FloorMaterial ~= Enum.Material.Air and ratio > 0.1 then
				local ph = os.clock() * (7 + 5 * ratio)
				off += Vector3.new(math.cos(ph * 0.5) * 0.09, math.abs(math.sin(ph)) * 0.14 - 0.07, 0) * ratio * CONFIG.CameraShake
			end
			if camKick > 0.01 then
				off += Vector3.new(camRng:NextNumber(-1, 1), camRng:NextNumber(-1, 1), camRng:NextNumber(-1, 1)) * camKick * 0.3
				camKick = camKick * math.max(1 - dt * 9, 0)
			else
				camKick = 0
			end
			camOff = camOff:Lerp(off, math.clamp(dt * 22, 0, 1))
			hum.CameraOffset = camOff
		end)
	end
end

