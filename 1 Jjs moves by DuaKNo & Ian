local function getRig()
	local char = lp.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then return end
	if hum.RigType.Name ~= CONFIG.RigType then return end
	return char, hum, root
end

local function stopDash()
	state.dashToken += 1
	if dashObjects then
		for _, obj in ipairs(dashObjects) do
			pcall(function() obj:Destroy() end)
		end
		dashObjects = nil
	end
	if dashPrevAutoRotate ~= nil then
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if h then pcall(function() h.AutoRotate = dashPrevAutoRotate end) end
		dashPrevAutoRotate = nil
	end
end

local function stopVault()
	state.vaultToken += 1
end

local function startDash(root, dirOverride, faceDir)
	stopDash()
	local token = state.dashToken
	local look = dirOverride or root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then return end
	if faceDir then -- dash lateral: fica de frente pra camera e vai de lado
		local _, h = getRig()
		if h then
			dashPrevAutoRotate = h.AutoRotate
			h.AutoRotate = false
		end
		local f = Vector3.new(faceDir.X, 0, faceDir.Z)
		if f.Magnitude > 1e-3 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + f.Unit)
		end
	end

	local att = Instance.new("Attachment")
	att.Name = "YujiDashAttachment"
	att.Parent = root

	local lv = Instance.new("LinearVelocity")
	lv.Name = "YujiDashVelocity"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.MaxForce = math.huge
	lv.VectorVelocity = flat.Unit * CONFIG.DashSpeed
	lv.Parent = root

	dashObjects = { lv, att }
	task.delay(CONFIG.DashTime, function()
		if state.dashToken == token then stopDash() end
	end)
end

-- volta suave pra pose normal: motor -> { from, t, dur }
local fades = {}
local function fadeToRest(motor, dur)
	local ok, from = pcall(function() return motor.Transform end)
	if not ok then return end
	fades[motor] = { from = from, t = 0, dur = math.max(dur, 0.01) }
end
track(RunService.Heartbeat:Connect(function(dt)
	for motor, f in pairs(fades) do
		if not motor.Parent then
			fades[motor] = nil
		else
			f.t += dt
			local a = math.clamp(f.t / f.dur, 0, 1)
			a = a * a * (3 - 2 * a)
			pcall(function() motor.Transform = f.from:Lerp(CFrame.new(), a) end)
			if f.t >= f.dur then fades[motor] = nil end
		end
	end
end))

-- devolve Animator, Animate e poses ao normal (de uma vez, so depois do fade)
local restoreBase
local function releaseBase(cur, dur)
	for _, motor in pairs(cur.motors) do
		fadeToRest(motor, dur)
	end
	task.delay(dur + 0.03, function()
		if donor == cur then
			donor = nil
			restoreBase(cur)
		end
	end)
end

function restoreBase(cur)
	for _, motor in pairs(cur.motors) do
		fades[motor] = nil
		pcall(function() motor.Transform = CFrame.new() end)
	end
	if cur.removedAnimator and cur.hum.Parent and not cur.hum:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = cur.hum
	end
	if cur.animate and cur.animate.Parent then
		cur.animate.Disabled = cur.animateWasDisabled
	end
end

local function removeAnimator(cur)
	local animator = cur.hum:FindFirstChildOfClass("Animator")
	if animator then
		animator:Destroy()
		cur.removedAnimator = true
	end
end

-- natural = terminou sozinha (chama onDone e deixa ela passar o estado base pra proxima)
local function endCurrent(natural)
	local cur = current
	if not cur then return end
	current = nil
	if cur.conn then
		cur.conn:Disconnect()
		cur.conn = nil
	end
	donor = cur
	if natural and cur.onDone then
		pcall(cur.onDone)
	end
	if donor == cur then
		-- ninguem assumiu: volta pra pose normal suavemente (donor continua valido durante o fade)
		releaseBase(cur, cur.anim.blendOut or CONFIG.BlendOut)
	end
end

-- aplica a pose; nos primeiros instantes mistura da pose anterior pra nova
local function applyPose(cur, jointName, motor, cf)
	local from = cur.blendFrom and cur.blendFrom[jointName]
	if from then
		local a = math.clamp(cur.blendT / cur.blendDur, 0, 1)
		a = a * a * (3 - 2 * a)
		cf = from:Lerp(cf, a)
	end
	motor.Transform = cf
end

local playSfxList -- definido mais abaixo

local function animScale(cur)
	local s = cur.anim.speed or 1
	if cur.anim.walkScaled then
		s = s * math.clamp(cur.hum.WalkSpeed / 16, 0.6, 2)
	end
	return s
end

local function step(cur, dt)
	local hum = cur.hum
	if hum.Health <= 0 or not hum.Parent then
		endCurrent(false)
		stopDash()
		return
	end
	removeAnimator(cur)

	local anim = cur.anim
	local frames, times = anim.frames, anim.times
	if cur.blendFrom then
		cur.blendT += dt
		if cur.blendT >= cur.blendDur then cur.blendFrom = nil end
	end
	dt = dt * animScale(cur)
	cur.elapsed += dt

	while cur.index < #frames and cur.elapsed >= times[cur.index + 1] do
		cur.index += 1
	end

	if cur.index >= #frames then
		for jointName, cf in pairs(frames[#frames].j) do
			local m = cur.motors[jointName]
			if m then applyPose(cur, jointName, m, cf) end
		end
		if anim.loop then
			cur.elapsed = math.max(cur.elapsed - anim.total, 0)
			cur.index = 1
			if anim.loopSfx and cur.root then
				playSfxList(cur, cur.root, anim.loopSfx, animScale(cur))
			end
		else
			endCurrent(true)
		end
		return
	end

	local a, b = frames[cur.index], frames[cur.index + 1]
	local span = math.max(times[cur.index + 1] - times[cur.index], 1e-6)
	local alpha = math.clamp((cur.elapsed - times[cur.index]) / span, 0, 1)
	for jointName, cfA in pairs(a.j) do
		local m = cur.motors[jointName]
		if m then
			local cfB = b.j[jointName]
			if CONFIG.Smooth and cfB then
				applyPose(cur, jointName, m, cfA:Lerp(cfB, alpha))
			else
				applyPose(cur, jointName, m, cfA)
			end
		end
	end
end

local SoundService = game:GetService("SoundService")

local function fxMount(char, root, m)
	local att = Instance.new("Attachment")
	local part = m and m.part and char:FindFirstChild(m.part, true)
	if part and part:IsA("BasePart") then
		att.CFrame = m.cf or CFrame.new()
		att.Parent = part
		return att, att
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = root.CFrame * ((m and m.cf) or CFrame.new())
	p.Parent = workspace
	att.Parent = p
	return att, p
end

local function fxSetProps(inst, props)
	for _, kv in ipairs(props) do
		pcall(function() inst[kv[1]] = kv[2] end)
	end
end

local function spawnFx(e, char, root)
	if e.kind == "sfx" then
		local s = Instance.new("Sound")
		fxSetProps(s, e.props)
		s.Parent = e.pos and root or SoundService
		s:Play()
		Debris:AddItem(s, e.dur or 5)
		return
	end

	local cls = e.class
	local fx = Instance.new(cls)
	fx.Name = e.name or cls
	fxSetProps(fx, e.props)
	local life = (e.dur or 2) + 2

	if cls == "Highlight" then
		fx.Adornee = char
		fx.Parent = char
	elseif cls == "Beam" or cls == "Trail" then
		local a0, h0 = fxMount(char, root, e.att0 or e.mount)
		local a1, h1 = fxMount(char, root, e.att1 or e.mount)
		fx.Attachment0, fx.Attachment1 = a0, a1
		fx.Parent = a0
		Debris:AddItem(h0, life)
		Debris:AddItem(h1, life)
	else
		local att, holder = fxMount(char, root, e.mount)
		if cls == "Fire" or cls == "Smoke" or cls == "Sparkles" then
			fx.Parent = att.Parent -- esses efeitos antigos precisam de uma BasePart
		else
			fx.Parent = att
		end
		if cls == "ParticleEmitter" then
			if e.enabled then
				fx.Enabled = true
				task.delay(e.dur or 1.5, function() pcall(function() fx.Enabled = false end) end)
			else
				fx.Enabled = false
				fx:Emit(e.emit or 10)
			end
		end
		Debris:AddItem(holder, life)
	end
	Debris:AddItem(fx, life)
end

-- sons: lista {t,id,vol,speed}; scale = velocidade da anim (anims com walkScaled)
function playSfxList(cur, root, list, scale)
	if not CONFIG.Sounds or not list then return end
	for _, s in ipairs(list) do
		task.delay(s.t / scale, function()
			if current ~= cur or not root.Parent then return end
			local snd = Instance.new("Sound")
			snd.SoundId = s.id
			snd.Volume = s.vol
			snd.PlaybackSpeed = s.speed
			snd.RollOffMode = Enum.RollOffMode.Linear
			snd.RollOffMinDistance = 10
			snd.RollOffMaxDistance = 300
			snd.Parent = root
			snd:Play()
			Debris:AddItem(snd, 3)
		end)
	end
end

-- sons (sfx, loopSfx) e efeitos completos (anim.fx, formato do logger)
local function playSfx(cur, root)
	local anim = cur.anim
	local speed = anim.speed or 1
	playSfxList(cur, root, anim.sfx, speed)
	playSfxList(cur, root, anim.loopSfx, animScale(cur))
	if anim.fx then
		for _, e in ipairs(anim.fx) do
			task.delay((e.t or 0) / speed, function()
				if current ~= cur or not root.Parent then return end
				if e.kind == "sfx" then
					if not CONFIG.Sounds then return end
				elseif not CONFIG.Effects then
					return
				end
				local ok, err = pcall(spawnFx, e, root.Parent, root)
				if not ok then warn("[Yuji FX] ignorado:", err) end
			end)
		end
	end
end

local scheduleHit -- definido mais abaixo (dano em NPCs)

-- layers: "action" (soco/dash) > "air" (pulo/queda/pouso) > "move" (correr)
-- uma layer mais forte interrompe a mais fraca, o contrario nao acontece
local function play(name, onDone, layer)
	layer = layer or "action"
	local anim = ANIMS[name]
	if not anim then return false end
	local char, hum, root = getRig()
	if not char then return false end
	if current then
		if layer == "air" and current.layer == "action" then return false end
		if layer == "move" and current.layer ~= "move" then return false end
	end

	local motors, count = {}, 0
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Motor6D") and anim.joints[d.Name] and d.Part1 and not motors[d.Name] then
			motors[d.Name] = d
			count += 1
		end
	end
	if count == 0 then return false end

	-- pega o estado base da animacao anterior pra nao reativar o Animate entre transicoes
	local inherited = nil
	if current then
		inherited = current
		current = nil
		if inherited.conn then
			inherited.conn:Disconnect()
			inherited.conn = nil
		end
	elseif donor then
		inherited = donor
	end
	donor = nil
	if inherited and inherited.hum ~= hum then
		restoreBase(inherited)
		inherited = nil
	end
	-- juntas da anim anterior que a nova nao usa: voltam suave pra pose normal
	-- (ficam na lista de motors da nova anim pra serem restauradas no fim)
	local fadeTime = anim.blendIn or CONFIG.BlendIn
	if inherited then
		for jointName, m in pairs(inherited.motors) do
			if not motors[jointName] then
				fadeToRest(m, math.max(fadeTime, 0.12))
				motors[jointName] = m
			end
		end
	end
	-- pose atual de cada junta = ponto de partida da mistura
	local blendFrom = {}
	for jointName, m in pairs(motors) do
		if anim.joints[jointName] then
			fades[m] = nil
			blendFrom[jointName] = m.Transform
		end
	end

	local animate, wasDisabled
	if inherited then
		animate = inherited.animate
		wasDisabled = inherited.animateWasDisabled
	else
		animate = char:FindFirstChild("Animate")
		wasDisabled = animate ~= nil and animate.Disabled
	end
	local cur = {
		name = name,
		anim = anim,
		layer = layer,
		hum = hum,
		motors = motors,
		onDone = onDone,
		animate = animate,
		animateWasDisabled = wasDisabled,
		removedAnimator = inherited and inherited.removedAnimator or false,
		elapsed = 0,
		index = 1,
		root = root,
		blendT = 0,
		blendDur = fadeTime,
		blendFrom = fadeTime > 0 and blendFrom or nil,
	}
	current = cur
	if animate then animate.Disabled = true end

	cur.conn = RunService.Heartbeat:Connect(function(dt)
		if current == cur then
			step(cur, dt)
			if ovApply then ovApply() end -- block por cima do walk/run, sempre depois da anim
		end
	end)
	step(cur, 0)
	playSfx(cur, root)
	scheduleHit(cur, root)
	return true
end

