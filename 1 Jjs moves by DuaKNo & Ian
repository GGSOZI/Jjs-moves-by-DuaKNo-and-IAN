-- Black Flash e uma Tool: o nome mostra o cooldown (segundos que faltam)
local controlsOn = false
local flashTool = nil
local flashRetryAt = 0
local function destroyFlashTool()
	if flashTool then
		pcall(function() flashTool:Destroy() end)
		flashTool = nil
	end
	if manjiTool then
		pcall(function() manjiTool:Destroy() end)
		manjiTool = nil
	end
end
local function makeManjiTool()
	local tool = Instance.new("Tool")
	tool.Name = "Manji Kick"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Manji Kick - counter (cooldown " .. CONFIG.ManjiCooldown .. "s)"
	tool.Activated:Connect(function() manjiKick() end)
	manjiTool = tool
	task.spawn(function()
		local bp = lp:WaitForChild("Backpack", 10)
		if bp and manjiTool == tool then tool.Parent = bp end
	end)
end
local function makeFlashTool()
	destroyFlashTool()
	local tool = Instance.new("Tool")
	tool.Name = "Black Flash"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Black Flash (cooldown " .. CONFIG.BlackFlashCooldown .. "s)"
	tool.Activated:Connect(function() blackFlash() end)
	flashTool = tool
	task.spawn(function()
		local bp = lp:WaitForChild("Backpack", 10)
		if bp and flashTool == tool then tool.Parent = bp end
	end)
	makeManjiTool()
end
track(RunService.Heartbeat:Connect(function()
	if manjiTool and manjiTool.Parent then
		local rem = manji.lockedUntil - os.clock()
		local want = (rem > 0) and string.format("%.1fs", rem) or "Manji Kick"
		if manjiTool.Name ~= want then manjiTool.Name = want end
	end
	if flashTool and flashTool.Parent then
		local rem = state.flashLockedUntil - os.clock()
		local want = (rem > 0) and string.format("%.1fs", rem) or "Black Flash"
		if flashTool.Name ~= want then flashTool.Name = want end
	elseif controlsOn and flashTool and os.clock() > flashRetryAt then
		-- o respawn limpou o Backpack e levou a tool junto: recria
		flashRetryAt = os.clock() + 1
		makeFlashTool()
	end
end))

-- botoes mobile: maiores e sempre longe do botao de pulo
local function layoutButtons()
	local btns = {}
	for _, a in ipairs({ ACTION_M1, ACTION_DASH, ACTION_BLOCK }) do
		local b = ContextActionService:GetButton(a)
		if not b then return end
		btns[#btns + 1] = b
	end
	local sg = btns[1]:FindFirstAncestorOfClass("ScreenGui")
	local parent = btns[1].Parent
	if not sg or not parent then return end
	local size = CONFIG.ButtonSize
	local sgPos, sgSize = sg.AbsolutePosition, sg.AbsoluteSize
	local jx, jy, jw, jh
	local pg = lp:FindFirstChildOfClass("PlayerGui")
	local tg = pg and pg:FindFirstChild("TouchGui")
	local jump = tg and tg:FindFirstChild("JumpButton", true)
	if jump and jump:IsA("GuiObject") and jump.AbsoluteSize.X > 0 then
		jx, jy = jump.AbsolutePosition.X, jump.AbsolutePosition.Y
		jw, jh = jump.AbsoluteSize.X, jump.AbsoluteSize.Y
	else
		jw, jh = 110, 110
		jx = sgPos.X + sgSize.X - 25 - jw
		jy = sgPos.Y + sgSize.Y - 25 - jh
	end
	local right = jx - CONFIG.ButtonJumpGap -- tudo fica a esquerda do pulo, com folga
	local bottom = jy + jh
	local gap = 16
	local spots = {
		{ right, bottom },                  -- M1
		{ right - size - gap, bottom },     -- DASH
		{ right, bottom - size - gap },     -- BLOCK
	}
	local pAbs = parent.AbsolutePosition
	for i, b in ipairs(btns) do
		local x = math.max(spots[i][1], sgPos.X + size + 8)
		local y = math.max(spots[i][2], sgPos.Y + size + 8)
		b.AnchorPoint = Vector2.new(1, 1)
		b.Size = UDim2.fromOffset(size, size)
		b.Position = UDim2.fromOffset(x - pAbs.X, y - pAbs.Y)
	end
end

-- tudo (botoes, teclas, tool) so existe em R6
local layoutToken = 0
local function unbindControls()
	for _, a in ipairs({ ACTION_M1, ACTION_DASH, ACTION_STOP, ACTION_BLOCK }) do
		pcall(function() ContextActionService:UnbindAction(a) end)
	end
end
local function setControls(on)
	if on then
		if not controlsOn then
			controlsOn = true
			ContextActionService:BindAction(ACTION_M1, onM1, true, Enum.UserInputType.MouseButton2) -- PC: botao direito
			ContextActionService:BindAction(ACTION_DASH, onDash, true, Enum.KeyCode.Q)
			ContextActionService:BindAction(ACTION_STOP, onStop, false, Enum.KeyCode.X) -- cancela tudo (so PC)
			ContextActionService:BindAction(ACTION_BLOCK, onBlock, true, Enum.KeyCode.F)
			setupButton(ACTION_M1, "M1")
			setupButton(ACTION_DASH, "DASH")
			setupButton(ACTION_BLOCK, "BLOCK")
			layoutToken += 1
			local tok = layoutToken
			task.spawn(function()
				while controlsOn and layoutToken == tok do
					pcall(layoutButtons)
					task.wait(0.5)
				end
			end)
		end
		makeFlashTool()
	else
		if controlsOn then
			controlsOn = false
			layoutToken += 1
			unbindControls()
		end
		destroyFlashTool()
		overlay.blocking = false
	end
end

local function refreshControls(char)
	task.spawn(function()
		local hum = char and char:WaitForChild("Humanoid", 10)
		if lp.Character ~= char then return end
		setControls(hum ~= nil and hum.RigType.Name == CONFIG.RigType)
	end)
end

