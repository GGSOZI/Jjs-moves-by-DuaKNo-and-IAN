local layoutToken = 0
local function unbindControls()
	for _, a in ipairs({ ACTION_M1, ACTION_DASH, ACTION_STOP, ACTION_BLOCK }) do
		pcall(function() ContextActionService:UnbindAction(a) end)
	end
end
local function setControls(on)
	if on then
		if not controlsOn then
			controlsOn = true
			ContextActionService:BindAction(ACTION_M1, onM1, true, Enum.UserInputType.MouseButton2)
			ContextActionService:BindAction(ACTION_DASH, onDash, true, Enum.KeyCode.Q)
			ContextActionService:BindAction(ACTION_STOP, onStop, false, Enum.KeyCode.X)
			ContextActionService:BindAction(ACTION_BLOCK, onBlock, true, Enum.KeyCode.F)
			setupButton(ACTION_M1, "M1")
			setupButton(ACTION_DASH, "DASH")
			setupButton(ACTION_BLOCK, "BLOCK")
			layoutToken += 1
			local tok = layoutToken
			task.spawn(function()
				while controlsOn and layoutToken == tok do
					pcall(layoutButtons)
					task.wait(0.5)
				end
			end)
		end
		makeFlashTool()
	else
		if controlsOn then
			controlsOn = false
			layoutToken += 1
			unbindControls()
		end
		destroyFlashTool()
		overlay.blocking = false
	end
end

local function refreshControls(char)
	task.spawn(function()
		local hum = char and char:WaitForChild("Humanoid", 10)
		if lp.Character ~= char then return end
		setControls(hum ~= nil and hum.RigType.Name == CONFIG.RigType)
	end)
end

track(lp.CharacterAdded:Connect(function(char)
	cancelAll()
	bindCharacter(char)
	refreshControls(char)
end))

if lp.Character then
	bindCharacter(lp.Character)
	refreshControls(lp.Character)
end

genv.YujiMovesetCleanup = function()
	cancelAll()
	controlsOn = false
	layoutToken += 1
	destroyFlashTool()
	pcall(function() ContextActionService:UnbindAction(ACTION_M1) end)
	pcall(function() ContextActionService:UnbindAction(ACTION_DASH) end)
	pcall(function() ContextActionService:UnbindAction(ACTION_STOP) end)
	pcall(function() ContextActionService:UnbindAction(ACTION_FLASH) end)
	pcall(function() ContextActionService:UnbindAction(ACTION_BLOCK) end)
	pcall(function() RunService:UnbindFromRenderStep("YujiCamFollow") end)
	pcall(function() RunService:UnbindFromRenderStep("YujiOverlay") end)
	pcall(endStrafe)
	pcall(function()
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if h then h.CameraOffset = Vector3.zero end
	end)
	if stateConn then
		stateConn:Disconnect()
		stateConn = nil
	end
	for _, conn in ipairs(connections) do
		pcall(function() conn:Disconnect() end)
	end
	connections = {}
	genv.YujiMovesetCleanup = nil
end

