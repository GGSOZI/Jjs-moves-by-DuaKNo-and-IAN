local function samplePose(anim, tm)
	local frames, times = anim.frames, anim.times
	local i = 1
	while i < #frames and tm >= times[i + 1] do i += 1 end
	if i >= #frames then return frames[#frames].j end
	local a, b = frames[i], frames[i + 1]
	local al = math.clamp((tm - times[i]) / math.max(times[i + 1] - times[i], 1e-6), 0, 1)
	local out = {}
	for name, cf in pairs(b.j) do
		local from = a.j[name]
		out[name] = from and from:Lerp(cf, al) or cf
	end
	return out
end

